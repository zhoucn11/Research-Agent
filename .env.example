# 这里只放模型连接和密钥；算法参数与本地目录均使用代码默认值。

# Main Qwen API: Assistant, context compression and Synthesizer
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=your_dashscope_api_key
OPENAI_MODEL=qwen3.7-max-preview

# Independent Reviewer API
REVIEWER_BASE_URL=https://api.moonshot.cn/v1
REVIEWER_API_KEY=your_moonshot_api_key
REVIEWER_MODEL=kimi-k2.6

# Local vLLM used by LightRAG and low-risk batch tasks
LOCAL_LLM_BASE_URL=http://127.0.0.1:6006/v1
LOCAL_LLM_API_KEY=sk-local
LOCAL_LLM_MODEL=qwen3

# Optional dedicated LightRAG LLM; omit to reuse LOCAL_LLM_*
# LIGHTRAG_LLM_BASE_URL=http://127.0.0.1:6006/v1
# LIGHTRAG_LLM_API_KEY=sk-local
# LIGHTRAG_LLM_MODEL=qwen3

# Academic search and image understanding
S2_API_KEY=your_semantic_scholar_api_key
MULTIMODAL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MULTIMODAL_API_KEY=your_multimodal_api_key
MULTIMODAL_IMAGE_MODEL=qwen-vl-max
